# Modelo local para rodar o ProconBot no seu PC sem custo de cloud.
# Copie os valores desejados para .env quando quiser testar localmente.

# Sem MongoDB: o bot roda com persistencia desabilitada e sessao de conversa em memoria.
# O login do WhatsApp fica salvo em disco na pasta abaixo.
# MONGODB_URI=
# MONGODB_DB_NAME=

# API HTTP local. Sem MongoDB, a API de historico/dashboard fica desabilitada.
HTTP_PORT=3000

# Opcional para rotas protegidas da API, caso voce ative MongoDB depois.
JWT_SECRET=troque_por_uma_chave_local_forte

# Sem Gemini: o bot usa busca por palavra-chave como fallback.
# GEMINI_API_KEY=

# WhatsApp local
WHATSAPP_AUTH_PATH=.wwebjs_auth
WHATSAPP_AUTH_CLIENT_ID=proconbot-jacarei-local
PUPPETEER_HEADLESS=true

# Opcional: informe o numero em formato internacional para pareamento por codigo.
# Se deixar comentado, o bot mostra QR Code no terminal.
# WHATSAPP_PHONE_NUMBER=5511999999999

# Opcional: logs extras do Chromium/WhatsApp Web para diagnostico.
WHATSAPP_BROWSER_LOGS=false
